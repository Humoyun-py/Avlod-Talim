# Local development template. Never put real production secrets in Git.
DJANGO_SECRET_KEY=replace-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for local SQLite. Production must use a PostgreSQL URL.
# URL-encode special characters in username/password (for example @ as %40).
# DATABASE_URL=postgresql://avlod_user:URL_ENCODED_PASSWORD@127.0.0.1:5432/avlod_talim?sslmode=prefer

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

STUDENT_PAYMENT_DUE_DAY=5
TEACHER_SALARY_PERCENT=40
MONTHLY_LESSON_COUNT=12
DEMO_LESSONS_PER_ENROLLMENT=1
ABSENCE_DEDUCTION_LIMIT=3

# Production example (put in the server's protected EnvironmentFile, not here):
# Render may set SECRET_KEY; Django accepts it as an alias for DJANGO_SECRET_KEY.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<random value at least 50 chars>
# DJANGO_ALLOWED_HOSTS=api.example.uz
# DATABASE_URL=postgresql://avlod_user:URL_ENCODED_PASSWORD@127.0.0.1:5432/avlod_talim?sslmode=prefer
# CORS_ALLOWED_ORIGINS=https://admin.example.uz,https://director.example.uz
# CSRF_TRUSTED_ORIGINS=https://admin.example.uz,https://director.example.uz
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600

# Render Blueprint marks these two values as sync:false; set in dashboard:
# CORS_ALLOWED_ORIGINS=https://your-admin.onrender.com,https://your-director.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-admin.onrender.com,https://your-director.onrender.com

# Uploaded files use the local private_media/ directory.
# Render Free uses ephemeral storage: uploaded files can be lost on redeploy/restart.
